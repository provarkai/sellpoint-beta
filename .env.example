# Server
PORT=5174
HOST=0.0.0.0

# Supabase (Project Settings -> API, and -> Database for the connection string)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Comma-separated emails allowed onto backend.html (SellPoint's own cross-tenant admin panel)
PLATFORM_ADMIN_EMAILS=you@example.com

# Paystack (leave unset to disable real checkout - upgrade.html falls back to manual bank transfer)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Resend (leave unset to disable outbound email - founding-members.html signup
# still works, the welcome email send is just logged and skipped)
RESEND_API_KEY=
RESEND_FROM_EMAIL=SellersPoint <founders@sellerspoint.africa>

# Used to build the referral link in the welcome email. Defaults to the
# request's own host if unset (fine for local dev, set explicitly in prod).
PUBLIC_SITE_URL=
