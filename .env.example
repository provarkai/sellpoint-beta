# Server
PORT=5174
HOST=0.0.0.0

# Supabase (Project Settings -> API, and -> Database for the connection string)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Comma-separated emails allowed onto backend.html (SellPoint's own cross-tenant admin panel)
PLATFORM_ADMIN_EMAILS=you@example.com

# Paystack (leave unset to disable real checkout - upgrade.html falls back to manual bank transfer)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
