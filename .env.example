# Server
PORT=5174
HOST=0.0.0.0

# Optional - used to build the unsubscribe link in the daily digest email
# (server/scheduler.js). Defaults to https://sellerspoint.app if unset.
APP_BASE_URL=https://sellerspoint.app

# Supabase (Project Settings -> API for the URL/keys, and -> Database ->
# Connection Pooling for DATABASE_URL). Use the session pooler host
# (aws-1-<region>.pooler.supabase.com:6543), not the direct db.<ref>.supabase.co
# host - the direct host is IPv6-only and will fail to resolve on most
# hosting providers and local networks.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-1-eu-west-2.pooler.supabase.com:6543/postgres

# Comma-separated emails allowed to sign in at admin-login.html
# (SellersPoint's own cross-tenant admin panel, backend.html)
PLATFORM_ADMIN_EMAILS=admin@sellerspoint.ng

# Payment gateway - pick one with PAYMENT_PROVIDER (paystack/flutterwave/
# stripe, defaults to paystack) and fill in that provider's keys below.
# This is just the startup default - the platform admin (backend.html >
# Platform Settings) can switch providers and edit keys from Settings
# without touching env vars or redeploying; whatever's saved there wins
# once the server has loaded it. Without a configured, active provider,
# /api/payments/initialize and /api/addons/purchase return 400.
#
# Only Paystack and Flutterwave support the storefront's direct-to-seller
# payouts (split payments) - Stripe covers plan/add-on billing only, since
# payouts need Stripe Connect (a separate seller onboarding flow), which
# isn't built in this edition. See server/payments/ for the provider code.
PAYMENT_PROVIDER=paystack

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# The shared "secret hash" you set in Flutterwave's dashboard webhook
# config - Flutterwave doesn't HMAC-sign webhooks, it just echoes this
# value back in the verif-hash header for you to compare.
FLUTTERWAVE_SECRET_HASH=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the Stripe dashboard's webhook endpoint config (whsec_...) - used to
# verify the Stripe-Signature header on incoming webhook events.
STRIPE_WEBHOOK_SECRET=

# Optional - OpenRouter API key for AI Tools (product captions, replies,
# reminders, sales summaries). Without it, /api/ai/generate falls back to
# plain templates instead of real AI-generated text. OPENROUTER_MODEL is
# optional and defaults to openai/gpt-4o-mini - see openrouter.ai/models
# for other options.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional - Resend for the automated signup welcome email and adding new
# signups to a Resend Audience for later newsletter Broadcasts (composed and
# sent from the Resend dashboard, not from this app). Without RESEND_API_KEY,
# signup just skips both - nothing breaks. RESEND_FROM_EMAIL must be an
# address on a domain you've verified in Resend's Domains tab (Resend
# rejects arbitrary From addresses). RESEND_AUDIENCE_ID is optional on top of
# that - copy it from Resend's Audiences tab once you've created one; without
# it, welcome emails still send, the audience add just no-ops.
RESEND_API_KEY=
RESEND_FROM_EMAIL=SellersPoint <onboarding@sellerspoint.app>
RESEND_AUDIENCE_ID=

# Optional - where in-app Feedback submissions get emailed to (also needs
# RESEND_API_KEY above, same as the welcome email). Reply-To on that email is
# set to the submitting seller's own address, so replying in your inbox goes
# straight back to them. Defaults to support@sellerspoint.ng if unset.
FEEDBACK_NOTIFY_EMAIL=support@sellerspoint.ng

# Optional - Sentry DSN for error monitoring. Without it, errors only show up
# in Railway's console logs (still logged either way via console.error).
SENTRY_DSN=

# Optional - WasenderAPI for WhatsApp automation (Slice Five). One shared
# WhatsApp Business number (connected via QR code in the WasenderAPI
# dashboard, outside this codebase) sends on behalf of every business's
# customer-facing messages. Without WASENDER_API_KEY, direct sending is
# unavailable and the app falls back to its existing wa.me deep-link flow.
# WASENDER_WEBHOOK_SECRET must match the webhook secret set in the
# WasenderAPI dashboard when registering https://<your-domain>/api/webhooks/whatsapp
# as the webhook URL - without it, incoming webhook calls are rejected.
WASENDER_API_KEY=
WASENDER_WEBHOOK_SECRET=
